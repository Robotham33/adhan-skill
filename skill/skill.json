        "endpoint": {
          "uri": "arn:aws:lambda:eu-west-3:251894223886:function:adhan-skill-handler"
        }
      },
      "routines": {
        "endpoint": {
          "uri": "arn:aws:lambda:eu-west-3:251894223886:function:adhan-skill-handler"
        }
      }
    },
    "permissions": [
      { "name": "alexa::alerts:reminders:skill:readwrite" }
    ],
    "manifestVersion": "1.0",
    "privacyAndCompliance": {
      "locales": { "en-US": {}, "fr-FR": {} },
      "allowsPurchases": false,
      "isExportCompliant": true,
      "containsAds": false,
      "usesPersonalInfo": true,
      "isChildDirected": false,
      "isHealthcareSkill": false,
      "isFinancialServiceSkill": false
    }
  }
}
