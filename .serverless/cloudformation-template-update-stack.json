        },
        "CodeSha256": "rWkT3Vif2o8Gd7GDU2TZroKoVo5BOY6DULK4AonqH3I="
      }
    },
    "SchedulerMinuteEventsRuleSchedule1": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
