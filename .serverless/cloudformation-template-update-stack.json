{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The AWS CloudFormation template for this Serverless application",
  "Resources": {
    "SchedulerMinuteLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/adhan-scheduler-minute"
      }
    },
    "NightlyLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/adhan-nightly"
      }
    },
    "IamRoleLambdaExecution": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": {
              "Fn::Join": [
                "-",
                [
                  "adhan-routines",
                  "dev",
                  "lambda"
                ]
              ]
            },
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:CreateLogGroup",
                    "logs:TagResource"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/adhan-scheduler-minute:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/adhan-nightly:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/adhan-scheduler-minute:*:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/adhan-nightly:*:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:eu-west-3:*:*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem",
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan",
                    "dynamodb:DescribeTable"
                  ],
                  "Resource": [
                    "arn:aws:dynamodb:eu-west-3:*:table/AdhanUsers",
                    "arn:aws:dynamodb:eu-west-3:*:table/AdhanStats"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "events:DescribeRule",
                    "events:PutRule",
                    "events:PutTargets",
                    "events:RemoveTargets",
                    "events:DeleteRule"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:PutParameter",
                    "ssm:DeleteParameter"
                  ],
                  "Resource": "arn:aws:ssm:eu-west-3:*:parameter/serverless-framework/*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:CreateBucket",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:ListBucket",
                    "s3:GetObject"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Path": "/",
        "RoleName": {
          "Fn::Join": [
            "-",
            [
              "adhan-routines",
              "dev",
              {
                "Ref": "AWS::Region"
              },
              "lambdaRole"
            ]
          ]
        }
      }
    },
    "SchedulerMinuteLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "adhan-skill-deployment-bucket",
          "S3Key": "serverless/adhan-routines/dev/1759414199931-2025-10-02T14:09:59.931Z/schedulerMinute.zip"
        },
        "Handler": "backend-scheduler/index.handler",
        "Runtime": "nodejs18.x",
        "FunctionName": "adhan-scheduler-minute",
        "MemorySize": 1024,
        "Timeout": 6,
        "Environment": {
          "Variables": {
            "TABLE": "AdhanUsers",
            "STATS_TABLE": "AdhanStats",
            "CLIENT_ID": "",
            "CLIENT_SECRET": "",
            "TRIGGER_STAGE": "development",
            "TRIGGER_NAME": "AdhanTime"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "IamRoleLambdaExecution",
            "Arn"
          ]
        }
      },
      "DependsOn": [
        "SchedulerMinuteLogGroup"
      ]
    },
    "NightlyLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "adhan-skill-deployment-bucket",
          "S3Key": "serverless/adhan-routines/dev/1759414199931-2025-10-02T14:09:59.931Z/nightly.zip"
        },
        "Handler": "backend-scheduler/index.nightlyHandler",
        "Runtime": "nodejs18.x",
        "FunctionName": "adhan-nightly",
        "MemorySize": 1024,
        "Timeout": 6,
        "Environment": {
          "Variables": {
            "TABLE": "AdhanUsers",
            "STATS_TABLE": "AdhanStats",
            "CLIENT_ID": "",
            "CLIENT_SECRET": "",
            "TRIGGER_STAGE": "development",
            "TRIGGER_NAME": "AdhanTime"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "IamRoleLambdaExecution",
            "Arn"
          ]
        }
      },
      "DependsOn": [
        "NightlyLogGroup"
      ]
    },
    "SchedulerMinuteLambdaVersionFmKYhVbH99Cn1aUDC9Mf7mJ76jMBdHkrb40MprEE": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "SchedulerMinuteLambdaFunction"
        },
        "CodeSha256": "D5iLbr1+SbAcHsuWPYgDTV6apKAO9WnfxZxsy4KGTZ8="
      }
    },
    "NightlyLambdaVersionZEjNr5atLE1h1fcbHGjV5lOoROIKI2tm8VnB7KnyEc": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "NightlyLambdaFunction"
        },
        "CodeSha256": "D5iLbr1+SbAcHsuWPYgDTV6apKAO9WnfxZxsy4KGTZ8="
      }
    },
    "Adhanschedulerminuterule1EventBridgeRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "adhan-scheduler-minute-rule-1",
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "SchedulerMinuteLambdaFunction",
                "Arn"
              ]
            },
            "Id": "adhan-scheduler-minute-rule-1-target"
          }
        ]
      }
    },
    "SchedulerMinuteEventBridgeLambdaPermission1": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Fn::GetAtt": [
            "SchedulerMinuteLambdaFunction",
            "Arn"
          ]
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::Join": [
            ":",
            [
              "arn",
              {
                "Ref": "AWS::Partition"
              },
              "events",
              {
                "Ref": "AWS::Region"
              },
              {
                "Ref": "AWS::AccountId"
              },
              {
                "Fn::Join": [
                  "/",
                  [
                    "rule",
                    "adhan-scheduler-minute-rule-1"
                  ]
                ]
              }
            ]
          ]
        }
      }
    },
    "Adhannightlyrule1EventBridgeRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "adhan-nightly-rule-1",
        "ScheduleExpression": "rate(1 hour)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "NightlyLambdaFunction",
                "Arn"
              ]
            },
            "Id": "adhan-nightly-rule-1-target"
          }
        ]
      }
    },
    "NightlyEventBridgeLambdaPermission1": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Fn::GetAtt": [
            "NightlyLambdaFunction",
            "Arn"
          ]
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::Join": [
            ":",
            [
              "arn",
              {
                "Ref": "AWS::Partition"
              },
              "events",
              {
                "Ref": "AWS::Region"
              },
              {
                "Ref": "AWS::AccountId"
              },
              {
                "Fn::Join": [
                  "/",
                  [
                    "rule",
                    "adhan-nightly-rule-1"
                  ]
                ]
              }
            ]
          ]
        }
      }
    },
    "AdhanStatsTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "AdhanStats",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "AdhanUsersTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "AdhanUsers",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "userId",
            "KeyType": "HASH"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ServerlessDeploymentBucketName": {
      "Value": "adhan-skill-deployment-bucket",
      "Export": {
        "Name": "sls-adhan-routines-dev-ServerlessDeploymentBucketName"
      }
    },
    "SchedulerMinuteLambdaFunctionQualifiedArn": {
      "Description": "Current Lambda function version",
      "Value": {
        "Ref": "SchedulerMinuteLambdaVersionFmKYhVbH99Cn1aUDC9Mf7mJ76jMBdHkrb40MprEE"
      },
      "Export": {
        "Name": "sls-adhan-routines-dev-SchedulerMinuteLambdaFunctionQualifiedArn"
      }
    },
    "NightlyLambdaFunctionQualifiedArn": {
      "Description": "Current Lambda function version",
      "Value": {
        "Ref": "NightlyLambdaVersionZEjNr5atLE1h1fcbHGjV5lOoROIKI2tm8VnB7KnyEc"
      },
      "Export": {
        "Name": "sls-adhan-routines-dev-NightlyLambdaFunctionQualifiedArn"
      }
    }
  }
}