        },
        "CodeSha256": "rWkT3Vif2o8Gd7GDU2TZroKoVo5BOY6DULK4AonqH3I="
      }
    },
    "NightlyLambdaVersionwNynMHNtjcXX1rWf0vXCpOX8HzyxoMUR486TmNWL7c": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "NightlyLambdaFunction"
        },
        "CodeSha256": "rWkT3Vif2o8Gd7GDU2TZroKoVo5BOY6DULK4AonqH3I="
      }
    },
    "SchedulerMinuteLambdaVersion1AnvIzNILTos2FKP7S1K1LXz2WdoshRdpfyIQqr0OJY": {
