    "SkillHandlerLambdaVersionplJOsLjXPPRrQvYXYCU8WgrpqyRfhTNvYeAx6z3Qg": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
